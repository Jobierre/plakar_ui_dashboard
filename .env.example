# Exemple de configuration de plakar-ui : cp .env.example .env, puis remplir.
# Les variables vides gardent la valeur par défaut indiquée.

# --- Tailscale (sidecar) ---
# Clé d'authentification du nœud plakar-ui (admin Tailscale > Settings > Keys).
# Facultative : la ligne TS_AUTHKEY de compose.yaml est commentée, le nœud se
# connecte alors par l'URL que le sidecar affiche (docker compose logs
# tailscale). Décommentez-la pour une connexion par clé.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# Défense en profondeur, dans la politique du tailnet (console Tailscale >
# Access controls) : n'ouvrir vers plakar-ui que 443 et la plage d'Exploration,
# pour les seuls Utilisateurs autorisés. Par exemple, une fois le nœud tagué
# tag:plakar-ui :
#   "grants": [{"src": ["moi@example.com"], "dst": ["tag:plakar-ui"],
#               "ip": ["tcp:443", "tcp:9300-9320"]}]

# --- Accès ---
# Utilisateurs autorisés : identités Tailscale (emails), séparées par des
# virgules. Toute autre identité reçoit 403. Requis.
PLAKAR_UI_UTILISATEURS=moi@example.com
# Nom d'hôte public du service sur le tailnet, sans schéma ni port. Il sert aux
# liens d'Exploration, et les requêtes adressées à un autre nom sont refusées.
# Requis.
PLAKAR_UI_HOTE=plakar-ui.<tailnet>.ts.net

# --- Réseau ---
# IP LAN d'Unraid : le conteneur résout le nom `unraid` vers elle, pour joindre
# les `plakar server` avec les emplacements de Store habituels. Requise.
UNRAID_IP=192.168.1.10

# --- Relevés ---
# Seuil de retard par défaut des Stores (26h). Exemples : 26h, 8d, 1d12h.
PLAKAR_UI_SEUIL=
# Intervalle entre deux Relevés planifiés d'un Store (1h). Durée Go : 30m, 2h…
PLAKAR_UI_INTERVALLE=

# --- Explorations ---
# Durée sans trafic après laquelle une Exploration est arrêtée (15m).
PLAKAR_UI_INACTIVITE=
# Plage des ports publics d'Exploration (9300-9320). La config de
# `tailscale serve` en est déduite au démarrage du service : rien d'autre à
# modifier.
PLAKAR_UI_PORTS=
# Décalage entre le port public d'un Store et le port interne de son
# `plakar ui` (100). Doit dépasser la largeur de la plage.
PLAKAR_UI_DECALAGE=

# --- Stockage ---
# Dossier des volumes persistants, requis : plakar-config (config plakar avec
# les passphrases : sensible, droits 700/600), plakar-cache, plakar-data
# (paquets plakar : plugins s3…), state, serve et tailscale.
PLAKAR_UI_APPDATA=/mnt/user/appdata/plakar-ui
